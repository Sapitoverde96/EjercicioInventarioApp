<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="pneBorderPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="375.0" prefWidth="325.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cesur.valentin.ejercicioinventarioapp.controllers.LoginController">
   <center>
      <VBox fx:id="vbxVerticalSplit" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fx:id="imgFotoPerfil" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../profilePicture.png" />
               </image>
            </ImageView>
            <Button fx:id="btnLogin" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onMouseClicked="#login" style="-fx-border-radius: 20px; -fx-background-color: #0088ff; -fx-border-color: #0088ff; -fx-text-fill: #ffffff; -fx-font-weight: bold;" text="Iniciar sesión" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="Segoe UI" size="12.0" />
               </font>
               <padding>
                  <Insets bottom="8.0" left="40.0" right="40.0" top="8.0" />
               </padding>
            </Button>
         </children>
      </VBox>
   </center>
   <bottom>
      <Label fx:id="lblAuthor" text="© 2026. Valentin Leyton Golla" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
