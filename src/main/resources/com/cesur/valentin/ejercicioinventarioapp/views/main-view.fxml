<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>


<BorderPane fx:id="pneBorderPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cesur.valentin.ejercicioinventarioapp.controllers.MainController">
   <center>
      <TableView fx:id="tbvInventoryTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="tbcId" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="tbcName" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="tbcCategory" prefWidth="75.0" text="Categoría" />
            <TableColumn fx:id="tbcAvailability" prefWidth="75.0" text="Disponibilidad" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <top>
      <HBox fx:id="hbxHorizontalSplit" alignment="CENTER" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblTitle" style="-fx-font-weight: bold;" text="Listado de registros">
               <font>
                  <Font name="Segoe UI" size="12.0" />
               </font>
            </Label>
            <Separator fx:id="sprSeparator" opacity="0.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Separator>
            <Button fx:id="btnNew" mnemonicParsing="false" onAction="#add" style="-fx-border-radius: 20px; -fx-background-color: #0088ff; -fx-border-color: #0088ff; -fx-text-fill: #ffffff; -fx-font-weight: bold;" text="Nuevo" textFill="WHITE">
               <font>
                  <Font name="Segoe UI" size="12.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </top>
</BorderPane>
